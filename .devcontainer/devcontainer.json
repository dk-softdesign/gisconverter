{
  "name": "GIS Converter",
  // Node version tracks .nvmrc / Dockerfile.
  "image": "node:24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.1": {},
    "ghcr.io/jungaretti/features/make:1": {}
  },
  // Global npm installs go to a user-owned prefix: /usr/local in the node image is
  // root-owned and the container runs as "node".
  "containerEnv": {
    "NPM_CONFIG_PREFIX": "/home/node/.npm-global"
  },
  "remoteEnv": {
    "PATH": "/home/node/.npm-global/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "npm install -g vite-plus && npm ci",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Dev server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-vscode.makefile-tools",
        "yoavbls.pretty-ts-errors",
        "aaron-bond.better-comments",
        "eamodio.gitlens",
        "Anthropic.claude-code",
        "oxc.oxc-vscode",
        "firsttris.vscode-jest-runner",
        "VoidZero.vite-plus-extension-pack"
      ],
      "settings": {
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.oxc": "explicit"
        }
      }
    }
  },
  "remoteUser": "node"
}
